# =============================================================
# PAHAL ACADEMY — ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values
# =============================================================

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pahal_academy

# ─── App URLs ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── WhatsApp (Meta Cloud API) ────────────────────────────
# Get from: https://developers.facebook.com/apps/
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Email (Resend) ───────────────────────────────────────
# Get from: https://resend.com/api-keys
EMAIL_API_KEY=
EMAIL_FROM=noreply@pahalacademy.com

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
NEXTAUTH_SECRET=change_this_to_another_long_random_string
